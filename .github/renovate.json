{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "platformCommit": "disabled",
  "gitAuthor": "Renovate Bot <bot@renovateapp.com>",
  "extends": [
    "config:recommended",
    ":combinePatchMinorReleases",
    ":separateMultipleMajorReleases"
  ],
  "enabledManagers": ["cargo", "custom.regex", "github-actions", "mise"],
  "minimumReleaseAge": "3 days",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the S2 Lite image pulled by CI",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": [
        "docker pull (?<depName>ghcr\\.io/s2-streamstore/s2):(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": ["Automerge non-major updates"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "automergeStrategy": "rebase",
      "automergeType": "branch"
    },
    {
      "description": ["Use ci semantic type for GitHub Actions and mise updates"],
      "matchManagers": ["github-actions", "mise"],
      "semanticCommitType": "ci"
    },
    {
      "description": ["Use ci semantic type for workflow files"],
      "matchFileNames": [".github/workflows/**"],
      "semanticCommitType": "ci"
    },
    {
      "description": ["Do not require release age for dependency pins"],
      "matchUpdateTypes": ["pin"],
      "minimumReleaseAge": null
    },
    {
      "description": ["Keep Tract workspace crates compatible"],
      "matchManagers": ["cargo"],
      "matchSourceUrls": ["https://github.com/snipsco/tract"],
      "groupName": "Tract workspace crates",
      "rangeStrategy": "pin"
    },
    {
      "description": ["Keep OCRs and RTen workspace crates compatible"],
      "matchPackageNames": ["ocrs", "rten", "rten-imageproc"],
      "groupName": "OCRs and RTen workspace crates"
    }
  ]
}
