#!/usr/bin/env bash
#MISE description="Run S2 Lite integration tests (requires a working Docker daemon)"

set -euo pipefail

if ! docker info >/dev/null 2>&1; then
  echo "Docker is unavailable. Start Docker before running the S2 Lite integration tests."
  exit 1
fi

s2_image_tag=$(sed -n 's/^s2-testcontainers = "=\([^"]*\)"$/\1/p' net/s2/Cargo.toml)
: "${s2_image_tag:?Could not read the pinned s2-testcontainers version}"

for attempt in 1 2 3; do
  docker pull "ghcr.io/s2-streamstore/s2:$s2_image_tag" && break
  if [ "$attempt" = 3 ]; then
    echo "Could not pull the pinned S2 Lite image after three attempts."
    exit 1
  fi
  sleep 2
done

cargo test -p gst-plugin-s2 --test s2_lite -- --ignored --test-threads=1
